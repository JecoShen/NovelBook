{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "bun"
    ],
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "disableSourceOfProjectReferenceRedirect": true,
    "rootDir": ".",
    "baseUrl": "."
  }
}
